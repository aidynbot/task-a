# Ключ Google Gemini API (получить можно в Google AI Studio).
# Если оставить пустым или закомментировать, сервис автоматически переключится в мок-режим.
GEMINI_API_KEY=

# Модель Gemini для структурированного извлечения
GEMINI_MODEL=gemini-3-flash-preview

# Принудительное включение локального MockProvider без обращения к API (true / false)
USE_MOCK=false
